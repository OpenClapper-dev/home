{
  "name": "openclapper-home",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=22.23 <23"
  },
  "scripts": {
    "dev": "pnpm -C apps/site dev",
    "dev:init": "bash scripts/dev-init.sh",
    "wrangler": "wrangler",
    "lint": "oxlint",
    "typecheck": "bash scripts/typecheck.sh",
    "test": "pnpm -C packages/vocab test && pnpm -C apps/site test",
    "build": "bash scripts/build-check.sh",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "oxlint": "^1.88.0",
    "typescript": "^7.0.2",
    "wrangler": "4.150.0"
  }
}
